# ==========================================
# NATANIM FUND TELEGRAM BOT CONFIGURATION
# ==========================================

# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_bot_token_from_botfather_here

# Initial Super Admin Numeric Telegram User ID (e.g. 123456789)
# Obtain your ID from @userinfobot or @raw_data_bot on Telegram
ADMIN_TELEGRAM_ID=123456789

# Database file path (relative or absolute)
DATABASE_PATH=./data/natanim_fund.db

# Currency Settings
DEFAULT_CURRENCY=ETB
# Standard monthly contribution in integer minor units (e.g., 50000 = 500.00 ETB, 100000 = 1000.00 ETB)
DEFAULT_MONTHLY_AMOUNT_CENTS=50000

# Due day of the month for obligations (e.g., 10 means 10th of every month)
DUE_DAY_OF_MONTH=10

# Timezone (IANA format)
TIMEZONE=Africa/Addis_Ababa

# Reminder Schedule: Cron format (e.g., '0 9 5 * *' = 9:00 AM on the 5th of every month)
REMINDER_CRON_SCHEDULE=0 9 5 * *

# Automated Reminder minimum cooldown in hours between reminders for the same member/month
REMINDER_COOLDOWN_HOURS=72

# Environment: 'development' or 'production'
NODE_ENV=development

